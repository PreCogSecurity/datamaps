# Environment variables
#
# Copy this file to `.env` and adjust values as needed. Datamaps itself is a
# browser library and reads no environment variables at runtime; the variables
# below are used by the development tooling.

# Timezone used by the vendored d3 v3 test suite
# (src/js/components/d3/test/load.js). The d3 tests pin a fixed timezone so
# date-sensitive assertions are deterministic regardless of the machine that
# runs them.
TZ=America/Los_Angeles